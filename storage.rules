rules_version = '2';

// ──────────────────────────────────────────────────────────────────────────
//  BLEND — Storage Security Rules
//
//  Photos live under /users/{uid}/photos/*.
//  - Owner can write (size + content type enforced).
//  - Any authenticated user can read (so other users see profile pics).
//  - Public/anonymous access is denied.
// ──────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profile photos — auth-gated read, owner-only write
    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                    && request.resource.size < 5 * 1024 * 1024  // 5MB hard cap
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
